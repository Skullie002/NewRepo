<?php

// Generate a random number

$rand = rand();



// Get current time and calculate expiration time (1 minute from now)

$now = time();

$next_minute = strtotime("+1 minute", $now);



// Check if the "random" cookie exists

if (!isset($_COOKIE['random'])) {

    // Set the cookie to expire in 1 minute

    setcookie("random", $rand, $next_minute, "/", "", false, true); // HttpOnly enabled

} else {

    // Retrieve the random number from the cookie

    $rand = $_COOKIE['random'];

}



// Display the random number

echo "Random number: " . $rand;

?>

