<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>XML File Loader</title>

</head>

<body>

 

<h2>XML File Loader</h2>

 

<?php

// Load the XML file

$xml = simplexml_load_file('example.xml');

 

// Check if the XML is successfully loaded

if ($xml) {

    // Display the content of the XML file

    echo "<h3>Book Information:</h3>";

 

    foreach ($xml->book as $book) {

        echo "Title: " . $book->title . "<br>";

        echo "Author: " . $book->author . "<br>";

        echo "Price: $" . $book->price . "<br><br>";

    }

} else {

    echo "<p>Error loading XML file.</p>";

}

?>

 

</body>

</html>
